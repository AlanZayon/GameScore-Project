# ---------------------------------------------------------------------------
# GameScore environment configuration
# Copy this file to .env and adjust as needed:  cp .env.example .env
# Never commit the real .env file.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Credentials used by the postgres container and by the API.
POSTGRES_USER=gamescore
POSTGRES_PASSWORD=gamescore
POSTGRES_DB=gamescore
POSTGRES_PORT=5432

# Connection string used by Prisma / the API when running on the host machine.
DATABASE_URL=postgresql://gamescore:gamescore@localhost:5432/gamescore?schema=public

# Separate database used by the integration and e2e test suites.
# It is created and migrated automatically by `pnpm test:e2e`.
TEST_DATABASE_URL=postgresql://gamescore:gamescore@localhost:5432/gamescore_test?schema=public

# --- Redis ------------------------------------------------------------------
# Optional. When absent the API transparently falls back to in-memory
# rate limiting and caching, so the app still runs without Redis.
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
# Optional. When set, the Redis container requires AUTH (use with --profile apps).
REDIS_PASSWORD=

# --- Auth -------------------------------------------------------------------
# CHANGE THESE. Use long random values, e.g. `openssl rand -base64 48`.
JWT_SECRET=dev-only-access-token-secret-change-me-please-0123456789
JWT_REFRESH_SECRET=dev-only-refresh-token-secret-change-me-please-9876543210
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=2592000

# --- API --------------------------------------------------------------------
NODE_ENV=development
API_PORT=3001
API_GLOBAL_PREFIX=
LOG_LEVEL=debug
# Comma separated list of origins allowed to send credentialed requests.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# OpenAPI UI is on by default outside production. Set true to force it in prod.
ENABLE_SWAGGER=

# --- Domain rules -----------------------------------------------------------
# Minimum number of reviews a game needs before it can appear in "Top Rated".
RANKING_MINIMUM_REVIEWS=50
# Below this number of reviews the UI shows "few reviews" instead of a label.
SCORE_LABEL_MINIMUM_REVIEWS=10

# --- IGDB integration -------------------------------------------------------
# Create an application at https://dev.twitch.tv/console/apps to obtain these.
# Leaving them empty keeps the app fully functional; only game import is off.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- Web --------------------------------------------------------------------
# Browser-visible API URL.
NEXT_PUBLIC_API_URL=http://localhost:3001
# URL the web app itself is served from (used for canonical/OpenGraph URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side API URL. Inside docker compose this becomes http://api:3001.
API_INTERNAL_URL=http://localhost:3001
WEB_PORT=3000
