{
  "name": "@gamescore/api",
  "version": "0.1.0",
  "private": true,
  "description": "GameScore REST API (NestJS modular monolith)",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint src test prisma",
    "lint:fix": "eslint src test prisma --fix",
    "typecheck": "tsc -p tsconfig.spec.json",
    "test": "dotenv -e ../../.env -- jest --config jest.config.js",
    "test:watch": "dotenv -e ../../.env -- jest --config jest.config.js --watch",
    "test:cov": "dotenv -e ../../.env -- jest --config jest.config.js --coverage",
    "test:e2e": "dotenv -e ../../.env -- jest --config test/jest-e2e.config.js --runInBand",
    "prisma:generate": "prisma generate",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- prisma db seed",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "db:studio": "dotenv -e ../../.env -- prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@gamescore/shared": "workspace:*",
    "@gamescore/types": "workspace:*",
    "@nestjs/common": "11.1.29",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.29",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.29",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "6.5.0",
    "@node-rs/argon2": "2.1.0",
    "@prisma/client": "6.19.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "4.6.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@faker-js/faker": "10.5.0",
    "@gamescore/config": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.29",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.2.0",
    "@types/supertest": "7.2.1",
    "dotenv-cli": "11.0.0",
    "eslint": "10.8.1",
    "jest": "30.4.2",
    "pino-pretty": "13.1.3",
    "prisma": "6.19.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
