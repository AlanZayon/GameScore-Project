{
  "name": "@gamescore/api",
  "version": "0.1.0",
  "private": true,
  "description": "GameScore REST API (ASP.NET Core) + Prisma schema/migrations",
  "scripts": {
    "dev": "dotnet run --project src/GameScore.Api/GameScore.Api.csproj --launch-profile http",
    "build": "dotnet build GameScore.slnx -c Release",
    "start": "dotnet run --project src/GameScore.Api/GameScore.Api.csproj -c Release --no-build",
    "test": "dotnet test GameScore.slnx --no-restore",
    "test:e2e": "dotnet test GameScore.slnx --filter FullyQualifiedName~Api.Tests",
    "lint": "dotnet build GameScore.slnx -warnaserror:false",
    "lint:fix": "dotnet build GameScore.slnx -warnaserror:false",
    "typecheck": "dotnet build GameScore.slnx -warnaserror:false",
    "prisma:generate": "prisma generate",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- prisma db seed",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "db:studio": "dotenv -e ../../.env -- prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@gamescore/shared": "workspace:*",
    "@node-rs/argon2": "2.1.0",
    "@prisma/client": "6.19.3",
    "dotenv-cli": "11.0.0",
    "prisma": "6.19.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
