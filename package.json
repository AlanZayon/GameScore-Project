{
  "name": "gamescore",
  "version": "0.1.0",
  "private": true,
  "description": "GameScore - a game discovery and rating platform driven by real player recommendations",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter \"./apps/*\" dev",
    "dev:infra": "docker compose up -d postgres redis mailpit",
    "dev:infra:down": "docker compose down",
    "build": "corepack pnpm -r build",
    "start": "corepack pnpm --parallel --filter \"./apps/*\" start",
    "lint": "corepack pnpm -r lint",
    "lint:fix": "corepack pnpm -r lint:fix",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test",
    "test:e2e": "corepack pnpm --filter @gamescore/api test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css}\"",
    "db:generate": "corepack pnpm --filter @gamescore/api db:generate",
    "db:migrate": "corepack pnpm --filter @gamescore/api db:migrate",
    "db:migrate:deploy": "corepack pnpm --filter @gamescore/api db:migrate:deploy",
    "db:seed": "corepack pnpm --filter @gamescore/api db:seed",
    "db:reset": "corepack pnpm --filter @gamescore/api db:reset",
    "db:studio": "corepack pnpm --filter @gamescore/api db:studio"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  }
}
