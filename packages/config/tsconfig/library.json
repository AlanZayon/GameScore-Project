{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "GameScore library (framework agnostic, consumed by both API and web)",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "declaration": true,
    "declarationMap": true,
    "composite": false,
    "isolatedModules": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": []
  }
}
