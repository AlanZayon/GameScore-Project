{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "GameScore Node/NestJS service",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false,
    "removeComments": true,
    "incremental": true,
    "strictBindCallApply": true,
    "noUnusedLocals": false,
    "types": ["node"]
  }
}
