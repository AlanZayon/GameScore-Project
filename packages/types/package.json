{
  "name": "@gamescore/types",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP contract shared between the GameScore API and web app",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@gamescore/shared": "workspace:*"
  },
  "devDependencies": {
    "@gamescore/config": "workspace:*",
    "eslint": "10.8.1",
    "typescript": "5.9.3"
  }
}
